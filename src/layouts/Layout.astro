---
/**
 * src/layouts/Layout.astro — 공통 레이아웃 (헤더 nav + 푸터)
 * props: title, description?
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = 'Furnaceside Fables';
const { title, description = '아크나이츠 스토리 · 연표 · 오퍼레이터 아카이브 (비상업적 팬 사이트)' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;

const NAV = [
  { href: '/', label: '홈' },
  { href: '/timeline', label: '연표' },
  { href: '/story', label: '스토리' },
  { href: '/operator', label: '오퍼레이터' },
];
const current = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- 한국어 본문 폰트: Noto Serif KR -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- TODO(seo): astro.config.mjs 의 site 설정 후 canonical / og 태그 추가 -->
    <!-- 테마: 첫 페인트 전에 저장된 설정을 적용해 깜빡임 방지. 값: 'light' | 'dark' | (없음 = 시스템 설정) -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-brand" href="/">{SITE_NAME}</a>
        <nav aria-label="주 메뉴" class="site-nav-wrap">
          <ul class="list-plain site-nav">
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="테마 전환" title="테마: 시스템">
            <span data-theme-icon="auto">◐</span>
            <span data-theme-icon="light">☀</span>
            <span data-theme-icon="dark">☾</span>
          </button>
        </nav>
      </div>
    </header>

    <script>
      // 테마 토글: 시스템(auto) → 라이트 → 다크 → 시스템 …
      const ORDER = ['auto', 'light', 'dark'] as const;
      const LABEL: Record<string, string> = { auto: '시스템', light: '라이트', dark: '다크' };
      const btn = document.getElementById('theme-toggle');
      const current = () => {
        const t = document.documentElement.dataset.theme;
        return t === 'light' || t === 'dark' ? t : 'auto';
      };
      const render = () => {
        const cur = current();
        btn?.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((el) => {
          el.hidden = el.dataset.themeIcon !== cur;
        });
        btn?.setAttribute('title', `테마: ${LABEL[cur]}`);
      };
      btn?.addEventListener('click', () => {
        const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
        if (next === 'auto') {
          delete document.documentElement.dataset.theme;
          try { localStorage.removeItem('theme'); } catch {}
        } else {
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
        }
        render();
      });
      render();
    </script>

    <main class="site-main">
      <slot />
    </main>

    <!-- 맨 위로 (스크롤 후 표시) -->
    <button class="to-top" id="to-top" type="button" aria-label="맨 위로" title="맨 위로" hidden>↑</button>
    <script>
      const toTop = document.getElementById('to-top')!;
      const update = () => {
        toTop.hidden = window.scrollY < 400;
      };
      window.addEventListener('scroll', update, { passive: true });
      toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      update();
    </script>

    <footer class="site-footer">
      <div class="container small muted">
        <p>
          비상업적 팬 사이트. 아크나이츠(明日方舟)의 모든 텍스트·명칭의 권리는 Hypergryph / Yostar 에 있습니다.
          게임 데이터: <a href="https://github.com/ArknightsAssets/ArknightsGamedata">ArknightsAssets/ArknightsGamedata</a>
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--color-line);
        background: var(--color-card);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
        flex-wrap: wrap;
      }
      .site-brand {
        font-weight: 700;
        color: var(--color-fg);
        letter-spacing: 0.02em;
      }
      .site-nav-wrap {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }
      .site-nav {
        display: flex;
        gap: 1.25rem;
        font-family: var(--font-sans);
        font-size: 0.95rem;
      }
      .theme-toggle {
        font: inherit;
        font-size: 1rem;
        line-height: 1;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--color-line);
        border-radius: 50%;
        background: var(--color-card);
        color: var(--color-fg);
        cursor: pointer;
      }
      .theme-toggle:hover {
        border-color: var(--color-accent);
      }
      .site-nav a {
        color: var(--color-muted);
      }
      .site-nav a[aria-current='page'] {
        color: var(--color-fg);
        font-weight: 600;
      }
      .site-main {
        flex: 1;
        padding: 2rem 0 3rem;
      }
      .to-top {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 50%;
        border: 1px solid var(--color-line);
        background: var(--color-card);
        color: var(--color-fg);
        font: inherit;
        font-size: 1rem;
        line-height: 1;
        cursor: pointer;
        opacity: 0.85;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
        z-index: 10;
      }
      .to-top:hover {
        opacity: 1;
        border-color: var(--color-accent);
      }
      .site-footer {
        border-top: 1px solid var(--color-line);
        padding: 1.5rem 0;
      }
    </style>
  </body>
</html>
