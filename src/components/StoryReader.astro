---
/**
 * src/components/StoryReader.astro — 파싱된 스토리 라인 렌더링.
 * props:
 *   lines         parseStory() 결과
 *   nameToId?     화자 이름 → 오퍼레이터 id (이름을 오퍼레이터 페이지로 링크)
 *   speakerNames? 중국어 화자 이름 → 한국어 표기 (CN 원문 스토리에서 이름만이라도 한국어로)
 *   faces?        화자 이름 → 오퍼레이터 id (대사 옆 아바타)
 *
 * 아바타가 없는 화자(스토리 전용 NPC)는 이름 첫 글자 배지로 대신한다.
 * AVG 전신 스프라이트는 장당 340~600KB 라 목록에 깔지 않고, 눌렀을 때만 받아 팝업으로 띄운다.
 *
 * TODO(reader): 배경/CG 이미지 표시, 선택지 분기 접기, 폰트 크기 조절 등은 여기서 확장.
 */
import { richTextToHtml } from '../lib/story-parser.mjs';
import { operatorAvatar, avgSprite } from '../lib/assets.mjs';

interface Props {
  lines: Array<Record<string, any>>;
  nameToId?: Map<string, string>;
  speakerNames?: Record<string, string>;
  faces?: Record<string, string>;
}

const { lines, nameToId = new Map(), speakerNames = {}, faces = {} } = Astro.props;
/** CN 원문 화자 이름을 한국어 표기로 (대응표에 없으면 원문 그대로) */
const display = (n: string) => speakerNames[n] ?? n;
const faceId = (n: string) => faces[display(n)] ?? faces[n] ?? null;
/** 아바타가 없는 화자: 이름으로 색을 정해 늘 같은 배지가 나오게 한다 */
const hue = (n: string) => {
  let h = 0;
  for (const ch of n) h = (h * 31 + ch.codePointAt(0)!) % 360;
  return h;
};
// 이 스토리에 나오는 스프라이트만 모아 둔다 (누르면 그때 받는다)
const spriteUrls: Record<string, string> = {};
for (const l of lines) {
  if (l.type !== 'dialogue' || !l.sprite || spriteUrls[l.sprite]) continue;
  const url = avgSprite(l.sprite);
  if (url) spriteUrls[l.sprite] = url;
}
const hasSprites = Object.keys(spriteUrls).length > 0;
const html = (t: string) => richTextToHtml(t ?? '');
const branchLabel = (b?: string[]) => (b ? `선택 ${b.join(', ')}` : null);
---

<div class="reader">
  {lines.map((line) => {
    const branch = branchLabel(line.branch);
    switch (line.type) {
      case 'header':
        return null; /* 내부용 제목(중국어 원제)은 표시하지 않음 */
      case 'dialogue': {
        const name = display(line.speaker);
        const opId = nameToId.get(name) ?? nameToId.get(line.speaker);
        const face = faceId(line.speaker);
        const avatar = face ? operatorAvatar(face) : null;
        return (
          <div class:list={['line', 'line--dialogue', { 'line--continued': line.continued }]} data-branch={branch}>
            <span class="speaker">
              {(() => {
                const inner = avatar ? (
                  <img class="face" src={avatar} alt="" loading="lazy" decoding="async" width="28" height="28" />
                ) : (
                  <span class="face face--initial" style={`--h:${hue(name)}`} aria-hidden="true">{[...name][0] ?? '?'}</span>
                );
                const sprite = line.sprite && spriteUrls[line.sprite] ? line.sprite : null;
                return sprite ? (
                  <button type="button" class="face-btn" data-sprite={sprite} data-name={name} title={`${name} 전신 일러스트 보기`}>
                    {inner}
                  </button>
                ) : (
                  inner
                );
              })()}
              <span class="speaker__name">
                {opId ? <a href={`/operator/${opId}`}>{name}</a> : name}
              </span>
            </span>
            <p class="text" set:html={html(line.text)} />
          </div>
        );
      }
      case 'narration':
        return <p class="line line--narration" data-branch={branch} set:html={html(line.text)} />;
      case 'decision':
        return (
          <div class="line line--decision">
            <span class="decision-label">선택지</span>
            <ol>
              {line.options.map((o: any) => (
                <li value={Number(o.value) || undefined}>{o.text}</li>
              ))}
            </ol>
          </div>
        );
      case 'predicate':
        return (
          <div class:list={['line', 'line--predicate', { 'line--merged': line.merged }]}>
            {line.merged ? '— 분기 합류 —' : `— 선택 ${line.references.join(', ')} —`}
          </div>
        );
      case 'subtitle':
        return <p class="line line--subtitle" data-branch={branch} set:html={html(line.text)} />;
      case 'sticker':
        return <p class="line line--sticker" data-branch={branch} set:html={html(line.text)} />;
      case 'caption':
        return <p class="line line--caption" data-branch={branch}>{line.text}</p>;
      case 'scene':
        return <hr class="line line--scene" data-image={line.image ?? undefined} />;
      case 'image':
        return <div class="line line--image muted small" data-image={line.image}>[CG: {line.image}]</div>;
      case 'tutorial':
        return <p class="line line--tutorial" data-branch={branch} set:html={html(line.text)} />;
      default:
        return null;
    }
  })}

  {hasSprites && (
    <>
      <script type="application/json" id="sprite-urls" set:html={JSON.stringify(spriteUrls)} />
      <div class="lightbox" id="sprite-box" hidden>
        <button type="button" class="lightbox__close" id="sprite-close" aria-label="닫기">×</button>
        <figure class="lightbox__fig">
          <img id="sprite-img" alt="" />
          <figcaption id="sprite-cap" class="small"></figcaption>
        </figure>
      </div>
    </>
  )}
</div>

<script>
  // 전신 일러스트 팝업. 이미지는 누르기 전까지 받지 않는다 (장당 340~600KB).
  const box = document.getElementById('sprite-box') as HTMLElement | null;
  if (box) {
    const urls: Record<string, string> = JSON.parse(
      document.getElementById('sprite-urls')?.textContent ?? '{}',
    );
    const img = document.getElementById('sprite-img') as HTMLImageElement;
    const cap = document.getElementById('sprite-cap')!;
    const close = () => {
      box.hidden = true;
      img.removeAttribute('src'); // 닫으면 디코딩된 이미지를 놓아 준다
      document.body.style.overflow = '';
    };
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLElement>('.face-btn');
      if (btn) {
        const url = urls[btn.dataset.sprite ?? ''];
        if (!url) return;
        const name = btn.dataset.name ?? '';
        img.src = url;
        img.alt = `${name} 전신 일러스트`;
        cap.textContent = name;
        box.hidden = false;
        document.body.style.overflow = 'hidden';
        return;
      }
      if (!box.hidden && (target === box || target.closest('#sprite-close'))) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.hidden) close();
    });
  }
</script>

<style>
  .reader {
    max-width: var(--measure);
    margin: 0 auto;
  }
  .line {
    margin: 0 0 1rem;
  }
  .line--dialogue {
    display: grid;
    grid-template-columns: minmax(7rem, 10rem) 1fr;
    gap: 0.75rem;
    align-items: start;
  }
  .line--continued {
    margin-top: -0.6rem;
  }
  .line--continued .speaker {
    visibility: hidden;
  }
  .speaker {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    font-weight: 600;
    text-align: right;
    color: var(--color-accent);
    font-size: 0.95em;
    line-height: 1.4;
  }
  .speaker a {
    color: inherit;
  }
  .speaker__name {
    min-width: 0;
  }
  .face {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-line);
    object-fit: cover;
  }
  .face-btn {
    display: flex;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 50%;
  }
  .face-btn:hover .face,
  .face-btn:focus-visible .face {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgb(0 0 0 / 0.82);
    cursor: zoom-out;
  }
  /* display:flex 가 [hidden] 을 이기므로 명시적으로 */
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-height: 100%;
  }
  .lightbox__fig img {
    max-width: min(90vw, 40rem);
    max-height: 80vh;
    object-fit: contain;
  }
  .lightbox__fig figcaption {
    font-family: var(--font-sans);
    color: #fff;
  }
  .lightbox__close {
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
  }
  .face--initial {
    display: grid;
    place-items: center;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    color: hsl(var(--h) 35% 85%);
    background: hsl(var(--h) 22% 30%);
  }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .face--initial {
      color: hsl(var(--h) 30% 25%);
      background: hsl(var(--h) 35% 85%);
    }
  }
  .text {
    margin: 0;
  }
  .line--narration {
    color: var(--color-muted);
  }
  .line--subtitle {
    text-align: center;
    font-style: italic;
  }
  .line--sticker {
    white-space: pre-line;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-line);
  }
  .line--caption {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.85em;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }
  .line--scene {
    border: 0;
    border-top: 1px dashed var(--color-line);
    margin: 2rem auto;
    width: 40%;
  }
  .line--decision {
    background: var(--color-accent-soft);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }
  .decision-label {
    font-family: var(--font-sans);
    font-size: 0.8em;
    color: var(--color-accent);
  }
  .line--decision ol {
    margin: 0.25rem 0 0;
    padding-left: 1.5rem;
  }
  .line--predicate {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.8em;
    color: var(--color-muted);
  }
  .line--tutorial {
    font-family: var(--font-sans);
    font-size: 0.9em;
    color: var(--color-muted);
  }
  @media (max-width: 480px) {
    .line--dialogue {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
    .speaker {
      text-align: left;
    }
  }
</style>
