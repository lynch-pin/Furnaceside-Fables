---
/**
 * / — 홈: 연표 미리보기 + 빠른 이동
 */
import Layout from '../layouts/Layout.astro';
import { loadTimeline, loadMeta, loadStories, loadOperators, KIND_LABEL } from '../lib/data.mjs';
import { pickDaily, todayKst } from '../lib/daily.mjs';

const timeline = loadTimeline();
const meta = loadMeta();
const { stories } = loadStories();
const operators = loadOperators();
const summaryOf = new Map(stories.map((s) => [s.id, s.summary]));

// 오늘의 추천: 읽을 수 있는 스토리가 있는 이벤트 중 날짜 시드로 4개.
// 정적 사이트이므로 빌드 시점 날짜로 미리 렌더하고, 브라우저에서 오늘(KST) 날짜로 다시 고른다.
const RECOMMEND_COUNT = 4;
const pool = timeline
  .filter((t) => t.stories.some((s: any) => s.available))
  .map((t) => {
    const first = t.stories.find((s: any) => s.available)!;
    const summary = t.stories.map((s: any) => summaryOf.get(s.id)).find(Boolean) ?? null;
    return {
      id: t.id,
      name: t.name,
      kindLabel: t.chapter?.label ?? KIND_LABEL[t.kind],
      period: t.loreLabel ?? '연대 미상',
      image: t.image ?? null,
      count: t.stories.filter((s: any) => s.available).length,
      firstStoryId: first.id,
      cn: t.sourceLocale === 'zh_CN',
      summary: summary ? summary.replace(/\s+/g, ' ').slice(0, 140) : null,
    };
  });
const buildDate = todayKst();
const picked = pickDaily(pool, RECOMMEND_COUNT, buildDate);

// 연표 미리보기: 세계관 연도별 이벤트 수 (연대 미상은 제외)
const yearCounts = new Map<number, number>();
for (const t of timeline) if (t.loreYear) yearCounts.set(t.loreYear, (yearCounts.get(t.loreYear) ?? 0) + 1);
const unresolved = timeline.filter((t) => !t.loreYear).length;
// 최근 출시 이벤트 5개 (참고용)
const recent = [...timeline].sort((a, b) => b.releaseTimestamp - a.releaseTimestamp).slice(0, 5);
---

<Layout>
  <div class="container">
    <section class="hero">
      <h1>Furnaceside Fables</h1>
      <p class="muted tagline">Arknights Story Reader with Timeline</p>
      <!-- TODO(home): 대표 이미지 -->
    </section>

    <section class="quick">
      <a class="card quick__item" href="/timeline">
        <strong>연표</strong>
        <span class="muted small">{timeline.length}개 이벤트 · 테라 력 순</span>
      </a>
      <a class="card quick__item" href="/story">
        <strong>스토리</strong>
        <span class="muted small">{stories.filter((s) => s.available).length}편</span>
      </a>
      <a class="card quick__item" href="/operator">
        <strong>오퍼레이터</strong>
        <span class="muted small">{operators.length}명</span>
      </a>
    </section>

    <section class="recommend">
      <h2>오늘의 스토리 추천 <span class="muted small" id="rec-date">{buildDate}</span></h2>
      <ul class="list-plain rec-list" id="rec-list">
        {picked.map((r) => (
          <li>
            <a class="card rec" href={`/timeline#${r.id}`}>
              {r.image ? (
                <img class="rec__thumb" src={r.image} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="rec__thumb thumb--placeholder" />
              )}
              <span class="rec__body">
                <span class="rec__title">
                  <span class="badge">{r.kindLabel}</span>
                  <strong>{r.name}</strong>
                  {r.cn && <span class="badge badge--fallback">CN server</span>}
                </span>
                <span class="muted small rec__meta">{r.period} · {r.count}편</span>
                {r.summary && <span class="muted small rec__summary">{r.summary}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="small muted">매일 바뀝니다. 항목을 누르면 연표에서 스토리 목록이 펼쳐집니다.</p>
    </section>

    <section>
      <h2>연표 미리보기</h2>
      <p class="muted small">테라 력 기준. 연도를 누르면 해당 구간으로 이동합니다.</p>
      <ul class="list-plain years">
        {[...yearCounts.entries()].map(([year, n]) => (
          <li>
            <a class="card years__item" href={`/timeline#y-${year}`}>
              <strong>{year}년</strong>
              <span class="muted small">{n}개 이벤트</span>
            </a>
          </li>
        ))}
        {unresolved > 0 && (
          <li>
            <a class="card years__item" href="/timeline#y-unknown">
              <strong>연대 미상</strong>
              <span class="muted small">{unresolved}개 이벤트</span>
            </a>
          </li>
        )}
      </ul>
      <p><a href="/timeline">전체 연표 보기 →</a></p>
    </section>

    <section>
      <h2>최근 출시</h2>
      <ol class="list-plain preview">
        {recent.map((g) => (
          <li class="preview__item">
            <span class="preview__date muted small">{g.releaseDate}</span>
            <span class="badge">{KIND_LABEL[g.kind]}</span>
            <a href={`/timeline#${g.id}`}>{g.name}</a>
            {g.sourceLocale === 'zh_CN' && <span class="badge badge--fallback">CN server</span>}
            <span class="muted small">{g.loreYear ? `${g.loreYear}년` : '연대 미상'}</span>
          </li>
        ))}
      </ol>
    </section>

    <script type="application/json" id="rec-pool" set:html={JSON.stringify(pool)} is:inline />

    <p class="small muted">
      데이터 버전: ko_KR {meta.versions.ko_KR ?? '-'} · zh_CN {meta.versions.zh_CN ?? '-'} · 생성 {meta.generatedAt.slice(0, 10)}
    </p>
  </div>
</Layout>

<script>
  // 빌드 시점 날짜로 렌더된 추천을 오늘(KST) 날짜 기준으로 다시 고른다.
  import { pickDaily, todayKst } from '../lib/daily.mjs';

  const list = document.getElementById('rec-list');
  const poolEl = document.getElementById('rec-pool');
  const dateEl = document.getElementById('rec-date');
  if (list && poolEl && dateEl) {
    const today = todayKst();
    if (today !== dateEl.textContent?.trim()) {
      const pool = JSON.parse(poolEl.textContent || '[]');
      const picked = pickDaily(pool, 4, today);
      const esc = (v: string) =>
        v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      list.innerHTML = picked
        .map(
          (r: any) => `<li><a class="card rec" href="/timeline#${esc(r.id)}">
            ${r.image ? `<img class="rec__thumb" src="${esc(r.image)}" alt="" loading="lazy" decoding="async">` : '<span class="rec__thumb thumb--placeholder"></span>'}
            <span class="rec__body">
              <span class="rec__title"><span class="badge">${esc(r.kindLabel)}</span><strong>${esc(r.name)}</strong>${r.cn ? '<span class="badge badge--fallback">CN server</span>' : ''}</span>
              <span class="muted small rec__meta">${esc(r.period)} · ${r.count}편</span>
              ${r.summary ? `<span class="muted small rec__summary">${esc(r.summary)}</span>` : ''}
            </span>
          </a></li>`,
        )
        .join('');
      dateEl.textContent = today;
    }
  }
</script>

<style>
  .hero {
    margin-bottom: 2rem;
  }
  .hero h1 {
    margin: 0 0 0.25rem;
  }
  .tagline {
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
    margin: 0;
  }
  .quick {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .quick__item {
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .recommend {
    margin-bottom: 2rem;
  }
  .rec-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0.6rem;
  }
  .rec {
    display: flex;
    gap: 0.75rem;
    padding: 0.6rem;
    color: inherit;
    height: 100%;
  }
  .rec:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .rec__thumb {
    width: 6rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-line);
    flex-shrink: 0;
  }
  .rec__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .rec__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
  }
  .rec__meta {
    font-family: var(--font-sans);
  }
  .rec__summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .years {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: 0.5rem;
  }
  .years__item {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0.8rem;
    color: inherit;
  }
  .preview__item {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .preview__date {
    font-family: var(--font-sans);
    min-width: 6.5rem;
  }
</style>
