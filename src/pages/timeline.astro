---
/**
 * /timeline — 스토리 연표. 이벤트 단위, 세계관 연도(테라 력) 기준 정렬.
 *   - 접힌 상태: 한 줄(썸네일·종류·이름·시기·출시일·편수)로 컴팩트하게
 *   - 펼치면: 큰 썸네일 + 스토리 목록(제목·태그·줄거리) — 스토리를 누르면 리더로 이동
 *   - 이벤트 연도: overrides → 인게임 아카이브 → 본문 날짜 스탬프(2편 이상) → 1편만(검수 필요) (scripts/process-data.mjs)
 *   - 회상이 섞인 이벤트도 주된 시기 한 곳에만 두고, 다른 연도의 스토리에는 연도만 작게 표시
 *   - 연도를 못 찾은 이벤트는 마지막 "연대 미상" 구역에 출시 순으로
 *
 * TODO(timeline): loreSource 가 'text-weak' / 'group-text' 인 항목은 자동 추정이므로 검수 후 overrides/timeline.json 에 확정값을 넣을 것.
 */
import Layout from '../layouts/Layout.astro';
import SourceBadge from '../components/SourceBadge.astro';
import { loadTimeline, loadStories, KIND_LABEL } from '../lib/data.mjs';

const timeline = loadTimeline();
const { stories } = loadStories();
const summaryOf = new Map(stories.map((s) => [s.id, s.summary]));

const SOURCE_LABEL: Record<string, string> = {
  override: '확정',
  archive: '인게임 아카이브',
  'group-text': '본문 날짜',
  'text-weak': '본문 날짜 (1편, 검수 필요)',
};

// 구역: 연도(오름차순) → 콜라보(테라 연대 밖) → 연대 미상
const COLLAB = '콜라보';
const UNKNOWN = '연대 미상';
const buckets = new Map<string, typeof timeline>();
for (const t of timeline) {
  const key = t.loreYear ? String(t.loreYear) : t.collab ? COLLAB : UNKNOWN;
  if (!buckets.has(key)) buckets.set(key, []);
  buckets.get(key)!.push(t);
}
const rank = (k: string) => (k === UNKNOWN ? 2 : k === COLLAB ? 1 : 0);
const byYear = new Map(
  [...buckets.entries()].sort(([a], [b]) => rank(a) - rank(b) || Number(a) - Number(b)),
);
const anchor = (key: string) => (key === UNKNOWN ? 'y-unknown' : key === COLLAB ? 'y-collab' : `y-${key}`);
const heading = (key: string) => (key === UNKNOWN || key === COLLAB ? key : `${key}년`);
---

<Layout title="연표">
  <div class="container">
    <h1>연표</h1>
    <p class="muted small">
      테라 력 기준, 이벤트 단위. 항목을 누르면 스토리 목록과 줄거리가 펼쳐집니다. 회상이 섞인 이벤트는 주된 시기에 배치했습니다.
      다른 작품과의 콜라보는 "콜라보" 구역에, 연도가 확인되지 않은 이벤트는 "연대 미상"에 출시 순으로 있습니다.
    </p>

    <nav class="shortcuts" aria-label="연도">
      {[...byYear.keys()].map((y) => (
        <a href={`#${anchor(y)}`}>{heading(y)} <span class="muted small">{byYear.get(y)!.length}</span></a>
      ))}
      <button type="button" id="toggle-all" class="muted">모두 펼치기</button>
    </nav>

    {[...byYear.entries()].map(([year, events]) => (
      <section class="year" id={anchor(year)}>
        <h2>{heading(year)} <span class="muted small">{events.length}개 이벤트</span></h2>
        <ol class="list-plain events">
          {events.map((t) => (
            <li class="event">
              <details class="card event__details" id={t.id}>
                <summary class="event__summary">
                  {t.image ? (
                    <img class="event__thumb" src={t.image} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="event__thumb thumb--placeholder">{t.chapter?.code ?? ''}</span>
                  )}
                  <span class="event__text">
                    <span class="event__title">
                      <span class="badge">{t.chapter?.label ?? KIND_LABEL[t.kind]}</span>
                      <strong>{t.name}</strong>
                      {t.collab && <span class="badge badge--collab">콜라보 · {t.collab}</span>}
                      <SourceBadge locale={t.sourceLocale} translated={t.translated} />
                    </span>
                    <span class="event__meta small muted">
                      {t.loreLabel && <span>{t.loreLabel}</span>}
                      {t.loreSource && (
                        <span class:list={['source', `source--${t.loreSource}`]} title={t.loreEvidence?.map((e: any) => e.text).join('\n') || undefined}>
                          {SOURCE_LABEL[t.loreSource] ?? t.loreSource}
                        </span>
                      )}
                      <span title="게임 내 공개일 (참고)">출시 {t.releaseDate ?? '-'}</span>
                      <span>{t.stories.length}편</span>
                    </span>
                  </span>
                  <span class="event__chevron" aria-hidden="true">▾</span>
                </summary>

                <div class="event__body">
                  {t.image && <img class="thumb event__hero" src={t.image} alt="" loading="lazy" decoding="async" />}
                  <ol class="list-plain stories">
                    {t.stories.map((s: any) => {
                      const summary = summaryOf.get(s.id);
                      return (
                        <li class="story">
                          <div class="story__head">
                            {s.available ? (
                              <a class="story__link" href={`/story/${s.id}`}>
                                {s.code && <span class="code">{s.code}</span>}
                                <span>{s.name}</span>
                              </a>
                            ) : (
                              <span class="muted">
                                {s.code && <span class="code">{s.code}</span>} {s.name} <span class="small">(원문 없음)</span>
                              </span>
                            )}
                            {s.avgTag && <span class="muted small">{s.avgTag}</span>}
                            {s.loreYear && s.loreYear !== t.loreYear && <span class="story-year" title="이 스토리 본문의 연도 (회상 등)">{s.loreYear}년</span>}
                            <SourceBadge locale={s.sourceLocale} translated={s.translated} />
                          </div>
                          {summary && <p class="story__summary small muted">{summary}</p>}
                        </li>
                      );
                    })}
                  </ol>
                  <p class="small"><a href={`/story#${t.id}`}>스토리 목록에서 보기 →</a></p>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>

<script>
  // 해시(#act11d0)로 들어오면 해당 이벤트를 펼치고, "모두 펼치기/접기" 토글 제공
  const all = Array.from(document.querySelectorAll<HTMLDetailsElement>('.event__details'));
  const openFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id && document.getElementById(id);
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  const toggle = document.getElementById('toggle-all') as HTMLButtonElement | null;
  toggle?.addEventListener('click', () => {
    const anyClosed = all.some((d) => !d.open);
    for (const d of all) d.open = anyClosed;
    toggle.textContent = anyClosed ? '모두 접기' : '모두 펼치기';
  });
</script>

<style>
  .year h2 {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    padding: 0.5rem 0;
    margin: 1.5rem 0 0.5rem;
    border-bottom: 1px solid var(--color-line);
    z-index: 1;
  }
  .events {
    border-left: 2px solid var(--color-line);
    margin-left: 0.5rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.4rem;
  }
  .event {
    position: relative;
  }
  .event::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 6px);
    top: 1.15rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .event__details {
    padding: 0;
  }
  .event__summary {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    list-style: none;
  }
  .event__summary::-webkit-details-marker {
    display: none;
  }
  .event__thumb {
    width: 5.5rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-line);
    flex-shrink: 0;
  }
  .event__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }
  .event__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
  }
  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.75rem;
    font-family: var(--font-sans);
  }
  .event__chevron {
    color: var(--color-muted);
    transition: transform 0.15s;
  }
  .event__details[open] .event__chevron {
    transform: rotate(180deg);
  }
  .event__body {
    border-top: 1px solid var(--color-line);
    padding: 0.75rem;
  }
  .event__hero {
    max-height: 14rem;
    margin-bottom: 0.75rem;
  }
  .source {
    padding: 0.05em 0.45em;
    border-radius: 3px;
    border: 1px solid var(--color-line);
    cursor: help;
  }
  .source--override {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .stories {
    display: grid;
    gap: 0.5rem;
  }
  .story__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
  }
  .story__link {
    color: var(--color-fg);
    font-weight: 600;
  }
  .story__link:hover {
    color: var(--color-link);
  }
  .story__summary {
    margin: 0.1rem 0 0;
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .code {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-accent);
    margin-right: 0.3rem;
  }
  .story-year {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  #toggle-all {
    margin-left: auto;
  }
</style>
