---
/**
 * /timeline — 스토리 연표. 이벤트(메인 챕터 / 사이드 / 미니) 단위, 세계관 연도(테라 력) 기준 정렬.
 *   - 이벤트 연도: overrides → 인게임 아카이브 → 본문 날짜 스탬프(2편 이상 일치) → 1편만(검수 필요) (scripts/process-data.mjs)
 *   - 회상이 섞인 이벤트도 "대부분의 사건이 벌어지는 시기" 한 곳에만 둔다. 개별 스토리의 연도가 다르면 작은 표시만.
 *   - 연도를 못 찾은 이벤트는 마지막 "연대 미상" 구역에 출시 순으로
 *   - 스토리 칩을 누르면 리더로 이동
 *
 * TODO(timeline): loreSource 가 'text-weak' / 'group-text' 인 항목은 자동 추정이므로 검수 후 overrides/timeline.json 에 확정값을 넣을 것.
 */
import Layout from '../layouts/Layout.astro';
import SourceBadge from '../components/SourceBadge.astro';
import { loadTimeline, KIND_LABEL } from '../lib/data.mjs';

const timeline = loadTimeline();

const SOURCE_LABEL: Record<string, string> = {
  override: '확정',
  archive: '인게임 아카이브',
  'group-text': '본문 날짜',
  'text-weak': '본문 날짜 (1편, 검수 필요)',
};

const UNKNOWN = '연대 미상';
const byYear = new Map<string, typeof timeline>();
for (const t of timeline) {
  const key = t.loreYear ? String(t.loreYear) : UNKNOWN;
  if (!byYear.has(key)) byYear.set(key, []);
  byYear.get(key)!.push(t);
}
const anchor = (key: string) => (key === UNKNOWN ? 'y-unknown' : `y-${key}`);
const heading = (key: string) => (key === UNKNOWN ? UNKNOWN : `${key}년`);
---

<Layout title="연표">
  <div class="container">
    <h1>연표</h1>
    <p class="muted small">
      테라 력 기준, 이벤트 단위. 회상이 섞인 이벤트는 주된 시기에 배치했고 다른 연도의 스토리에는 연도를 따로 표시합니다.
      연도가 확인되지 않은 이벤트는 맨 아래 "연대 미상"에 출시 순으로 있습니다.
    </p>

    <nav class="shortcuts" aria-label="연도">
      {[...byYear.keys()].map((y) => (
        <a href={`#${anchor(y)}`}>{heading(y)} <span class="muted small">{byYear.get(y)!.length}</span></a>
      ))}
    </nav>

    {[...byYear.entries()].map(([year, events]) => (
      <section class="year" id={anchor(year)}>
        <h2>{heading(year)} <span class="muted small">{events.length}개 이벤트</span></h2>
        <ol class="list-plain events">
          {events.map((t) => (
            <li class="event card" id={t.id}>
              <div class="event__media">
                {t.image ? (
                  <img class="thumb" src={t.image} alt="" loading="lazy" decoding="async" />
                ) : (
                  <div class="thumb thumb--placeholder">{t.chapter?.code ?? KIND_LABEL[t.kind]}</div>
                )}
              </div>
              <div class="event__body">
                <div class="event__head">
                  <span class="badge">{t.chapter?.label ?? KIND_LABEL[t.kind]}</span>
                  <h3 class="event__title">
                    <a href={`/story#${t.id}`}>{t.name}</a>
                  </h3>
                  <SourceBadge locale={t.sourceLocale} translated={t.translated} />
                </div>
                <div class="event__meta small muted">
                  {t.loreLabel && <span>{t.loreLabel}</span>}
                  {t.loreSource && (
                    <span class:list={['source', `source--${t.loreSource}`]} title={t.loreEvidence?.map((e: any) => e.text).join('\n') || undefined}>
                      {SOURCE_LABEL[t.loreSource] ?? t.loreSource}
                    </span>
                  )}
                  <span title="게임 내 공개일 (참고)">출시 {t.releaseDate ?? '-'}</span>
                  <span>{t.stories.length}편</span>
                </div>
                <ul class="list-plain stories">
                  {t.stories.map((s: any) => (
                    <li>
                      {s.available ? (
                        <a class="story-link" href={`/story/${s.id}`}>
                          {s.code && <span class="code">{s.code}</span>}
                          <span>{s.name}</span>
                          {s.avgTag && <span class="muted small">{s.avgTag}</span>}
                          {s.loreYear && s.loreYear !== t.loreYear && <span class="story-year" title="이 스토리 본문의 연도 (회상 등)">{s.loreYear}년</span>}
                        </a>
                      ) : (
                        <span class="story-link muted">
                          {s.code && <span class="code">{s.code}</span>}
                          <span>{s.name}</span>
                          <span class="small">(원문 없음)</span>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>

<style>
  .year h2 {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    padding: 0.5rem 0;
    margin: 1.5rem 0 0.5rem;
    border-bottom: 1px solid var(--color-line);
    z-index: 1;
  }
  .events {
    border-left: 2px solid var(--color-line);
    margin-left: 0.5rem;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .event {
    position: relative;
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem;
    padding: 0.75rem;
  }
  .event::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem - 6px - 0.75rem);
    top: 1.1rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .event__media .thumb {
    border-radius: 4px;
  }
  .event__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
  }
  .event__title {
    margin: 0;
    font-size: 1.15rem;
  }
  .event__title a {
    color: var(--color-fg);
  }
  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0.2rem 0 0.5rem;
    font-family: var(--font-sans);
  }
  .source {
    padding: 0.05em 0.45em;
    border-radius: 3px;
    border: 1px solid var(--color-line);
    cursor: help;
  }
  .source--override {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .stories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
  }
  .story-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.3rem 0.55rem; /* 터치 타깃 확보 */
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: inherit;
    font-size: 0.9rem;
  }
  a.story-link:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .code {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .story-year {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  @media (max-width: 600px) {
    .event {
      grid-template-columns: 1fr;
    }
    .event__media .thumb {
      max-height: 10rem;
    }
  }
</style>
