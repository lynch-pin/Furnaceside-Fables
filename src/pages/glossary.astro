---
/**
 * /glossary — 중국어 회화 표현 단어집.
 *   한국 서버와 중국 서버 스토리 스크립트가 줄 단위로 1:1 대응하는 점을 이용해
 *   scripts/build-glossary.mjs 가 만든 자료를 보여 준다.
 *     - 회화 표현: glossary/phrases.json 에 정리한 문장 (병음·직역·단어별 해설), 등장 빈도와 출처 포함
 *     - 단어: glossary/words.json 에 정리한 뜻풀이와 예문
 *   오퍼레이터 이름은 여기 넣지 않는다 (/operator 에서 중국어 이름을 함께 보여 준다).
 *
 *   발음 듣기는 브라우저 내장 음성 합성(Web Speech API)을 쓴다. 오디오 파일을 만들지 않으므로 용량이 늘지 않지만,
 *   기기에 중국어 음성이 없으면 동작하지 않아 버튼을 숨긴다.
 *
 * TODO(glossary): glossary/phrase-candidates.json 의 후보를 계속 정리해 표현을 늘릴 것.
 */
import Layout from '../layouts/Layout.astro';
import { loadGlossary } from '../lib/data.mjs';

const glossary = loadGlossary();
const phrases = glossary.phrases;
const words = glossary.words;

const CATEGORY_ORDER = ['세계관', '명사', '동사', '형용사', '부사', '대명사', '접속사', '조사·어기', '수량', '인사·감탄'];
const categories = CATEGORY_ORDER.filter((c) => words.some((w: any) => w.category === c));
const catCount = (c: string) => words.filter((w: any) => w.category === c).length;
---

<Layout title="단어집" description="아크나이츠 스토리에 자주 나오는 중국어 회화 표현을 병음·직역·단어 해설과 함께 모았습니다.">
  <div class="container">
    <h1>단어집</h1>
    <p class="muted small">
      한국 서버와 중국 서버의 스토리 스크립트를 줄 단위로 맞춰 만든 중국어-한국어 자료입니다.
      스토리 {glossary.stats.alignedStories}편에서 뽑았고, 표현을 누르면 단어별 해설이 펼쳐집니다.
    </p>

    <label class="search">
      <span class="shortcuts__label">검색</span>
      <input type="search" id="g-search" placeholder="중국어 / 병음 / 한국어" autocomplete="off" />
    </label>

    <div class="shortcuts speed" id="speed-toggle" role="group" aria-label="발음 속도" hidden>
      <span class="shortcuts__label">발음</span>
      <button type="button" data-rate="1" aria-pressed="true">보통</button>
      <button type="button" data-rate="0.6" aria-pressed="false">느리게</button>
    </div>

    <div class="tabs" role="tablist" aria-label="단어집">
      <button role="tab" id="tab-phrases" aria-controls="panel-phrases" aria-selected="true" data-tab="phrases">
        회화 표현 <span class="small">{phrases.length}</span>
      </button>
      <button role="tab" id="tab-words" aria-controls="panel-words" aria-selected="false" data-tab="words">
        단어 <span class="small">{words.length}</span>
      </button>
    </div>

    <!-- 회화 표현 -->
    <section role="tabpanel" id="panel-phrases" aria-labelledby="tab-phrases">
      <p class="muted small" id="p-result"></p>
      <ol class="list-plain entries" id="phrase-list">
        {phrases.map((p: any) => (
          <li data-key={`${p.cn} ${p.pinyin} ${p.kr}`.toLowerCase()}>
            <details class="entry card">
              <summary class="entry__head">
                <span class="cn" lang="zh-Hans">{p.cn}</span>
                <button class="speak" type="button" data-say={p.cn} aria-label="발음 듣기" title="발음 듣기" hidden>♪</button>
                <span class="pinyin muted">{p.pinyin}</span>
                <span class="kr">{p.kr}</span>
                {p.docs > 0 && <span class="muted small docs">{p.docs}편</span>}
              </summary>
              <div class="entry__body">
                {p.literal && <p class="literal small"><span class="muted">직역</span> {p.literal}</p>}
                <ol class="list-plain words">
                  {p.words.map((w: any) => (
                    <li class="word">
                      <span class="word__cn" lang="zh-Hans">{w.cn}</span>
                      <button class="speak" type="button" data-say={w.cn} aria-label="발음 듣기" title="발음 듣기" hidden>♪</button>
                      <span class="word__py muted">{w.pinyin}</span>
                      <span class="word__kr">{w.kr}</span>
                    </li>
                  ))}
                </ol>
                {p.note && <p class="note small muted">{p.note}</p>}
                {(p.krInStory || p.story) && (
                  <p class="source small muted">
                    {p.krInStory && <>스토리 번역: {p.krInStory}</>}
                    {p.story?.id && (
                      <>
                        {p.krInStory ? ' · ' : ''}
                        <a href={`/story/${p.story.id}`}>{p.story.name ?? '예문 보기'}</a>
                      </>
                    )}
                  </p>
                )}
              </div>
            </details>
          </li>
        ))}
      </ol>
      {phrases.length === 0 && <p class="muted">아직 정리한 표현이 없습니다.</p>}
    </section>

    <!-- 단어 -->
    <section role="tabpanel" id="panel-words" aria-labelledby="tab-words" hidden>
      <div class="shortcuts" role="group" aria-label="분류 필터" id="cat-filter">
        <span class="shortcuts__label">분류</span>
        <button type="button" data-all aria-pressed="true">전체</button>
        {categories.map((c) => (
          <button type="button" data-value={c} aria-pressed="true">{c} <span class="muted small">{catCount(c)}</span></button>
        ))}
      </div>
      <p class="muted small" id="w-result"></p>
      <ol class="list-plain entries" id="word-list">
        {words.map((w: any) => (
          <li class="entry card" data-cat={w.category} data-key={`${w.cn} ${w.pinyin ?? ''} ${w.kr}`.toLowerCase()}>
            <div class="entry__head">
              <span class="cn" lang="zh-Hans">{w.cn}</span>
              <button class="speak" type="button" data-say={w.cn} aria-label="발음 듣기" title="발음 듣기" hidden>♪</button>
              {w.pinyin && <span class="pinyin muted">{w.pinyin}</span>}
              <span class="kr">{w.kr}</span>
              <span class="badge">{w.category}</span>
              <span class="muted small docs">{w.docs}편</span>
            </div>
            {w.note && <p class="note small muted">{w.note}</p>}
            {w.example && (
              <p class="example small">
                <span lang="zh-Hans">{w.example.cn}</span>
                <span class="muted"> — {w.example.kr}</span>
                {w.example.story?.id && <a class="muted" href={`/story/${w.example.story.id}`} title={w.example.story.name ?? ''}>›</a>}
              </p>
            )}
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>

<script>
  // 발음 듣기: 브라우저 내장 음성 합성(Web Speech API). 오디오 파일을 받지 않는다.
  // 중국어 음성이 없는 기기에서는 버튼을 숨긴 채로 둔다.
  const synth = window.speechSynthesis;
  if (synth) {
    let zhVoice: SpeechSynthesisVoice | null = null;
    let rate = 1;
    try {
      const saved = Number(localStorage.getItem('tts-rate'));
      if (saved > 0) rate = saved;
    } catch {}

    const speedToggle = document.getElementById('speed-toggle');
    const rateButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-rate]'));

    const pickVoice = () => {
      const voices = synth.getVoices();
      zhVoice =
        voices.find((v) => v.lang.replace('_', '-').toLowerCase().startsWith('zh-cn')) ??
        voices.find((v) => v.lang.toLowerCase().startsWith('zh')) ??
        null;
      // 음성 목록이 비어 있는 브라우저도 lang 지정만으로 읽어 주는 경우가 있어, 목록이 있을 때만 판단한다
      const usable = zhVoice !== null || voices.length === 0;
      for (const b of document.querySelectorAll<HTMLButtonElement>('.speak')) b.hidden = !usable;
      if (speedToggle) speedToggle.hidden = !usable;
    };
    pickVoice();
    synth.addEventListener?.('voiceschanged', pickVoice);

    const setRate = (v: number) => {
      rate = v;
      for (const b of rateButtons) b.setAttribute('aria-pressed', String(Number(b.dataset.rate) === v));
      try {
        localStorage.setItem('tts-rate', String(v));
      } catch {}
    };
    setRate(rate);
    for (const b of rateButtons) b.addEventListener('click', () => setRate(Number(b.dataset.rate)));

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest?.('[data-say]') as HTMLButtonElement | null;
      if (!btn) return;
      // <summary> 안의 버튼이 펼침 토글을 건드리지 않게 한다
      e.preventDefault();
      e.stopPropagation();
      const text = btn.dataset.say ?? '';
      if (!text) return;
      synth.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = 'zh-CN';
      if (zhVoice) u.voice = zhVoice;
      u.rate = rate;
      btn.classList.add('speak--on');
      u.onend = () => btn.classList.remove('speak--on');
      u.onerror = () => btn.classList.remove('speak--on');
      synth.speak(u);
    });
  }

  // 탭 전환 + 검색 + 분류 필터. 상태는 URL 해시(#t=words&q=…&c=명사,동사)에 저장.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  const search = document.getElementById('g-search') as HTMLInputElement;
  const phraseItems = Array.from(document.querySelectorAll<HTMLLIElement>('#phrase-list > li'));
  const wordItems = Array.from(document.querySelectorAll<HTMLLIElement>('#word-list > li'));
  const catRoot = document.getElementById('cat-filter')!;
  const catAll = catRoot.querySelector<HTMLButtonElement>('[data-all]')!;
  const catItems = Array.from(catRoot.querySelectorAll<HTMLButtonElement>('[data-value]'));
  const pResult = document.getElementById('p-result')!;
  const wResult = document.getElementById('w-result')!;

  const on = (b: HTMLButtonElement) => b.getAttribute('aria-pressed') === 'true';
  const set = (b: HTMLButtonElement, v: boolean) => b.setAttribute('aria-pressed', String(v));
  const currentTab = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true')!.dataset.tab!;

  const apply = () => {
    const q = search.value.trim().toLowerCase();
    let pn = 0;
    for (const li of phraseItems) {
      const show = !q || (li.dataset.key ?? '').includes(q);
      li.hidden = !show;
      if (show) pn++;
    }
    const cats = new Set(catItems.filter(on).map((b) => b.dataset.value!));
    let wn = 0;
    for (const li of wordItems) {
      const show = cats.has(li.dataset.cat!) && (!q || (li.dataset.key ?? '').includes(q));
      li.hidden = !show;
      if (show) wn++;
    }
    set(catAll, catItems.every(on));
    pResult.textContent = pn === phraseItems.length ? '' : `${pn}개`;
    wResult.textContent = wn === wordItems.length ? '' : `${wn}개`;

    const parts: string[] = [];
    if (currentTab() !== 'phrases') parts.push(`t=${currentTab()}`);
    if (q) parts.push(`q=${encodeURIComponent(q)}`);
    if (!catItems.every(on)) parts.push(`c=${[...cats].map(encodeURIComponent).join(',')}`);
    history.replaceState(null, '', parts.length ? `#${parts.join('&')}` : location.pathname);
  };

  const selectTab = (id: string) => {
    for (const t of tabs) {
      const active = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(active));
      const panel = document.getElementById(`panel-${t.dataset.tab}`);
      if (panel) panel.hidden = !active;
    }
  };

  for (const t of tabs) {
    t.addEventListener('click', () => {
      selectTab(t.dataset.tab!);
      apply();
    });
  }
  catAll.addEventListener('click', () => {
    const every = catItems.every(on);
    for (const b of catItems) set(b, !every);
    apply();
  });
  for (const b of catItems) {
    b.addEventListener('click', () => {
      set(b, !on(b));
      apply();
    });
  }
  search.addEventListener('input', apply);

  const params = new URLSearchParams(location.hash.slice(1));
  if (params.get('t') === 'words') selectTab('words');
  if (params.get('q')) search.value = params.get('q')!;
  if (params.get('c')) {
    const want = new Set(params.get('c')!.split(',').map(decodeURIComponent));
    for (const b of catItems) set(b, want.has(b.dataset.value!));
  }
  apply();
</script>

<style>
  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    margin-bottom: 0.5rem;
  }
  .search input {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-fg);
    width: min(100%, 22rem);
  }
  .search input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .entries {
    display: grid;
    gap: 0.35rem;
  }
  .entry {
    padding: 0.5rem 0.75rem;
  }
  .entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.6rem;
    cursor: pointer;
    list-style: none;
  }
  .entry__head::-webkit-details-marker {
    display: none;
  }
  .cn {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .pinyin {
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .kr {
    flex: 1;
    min-width: 8rem;
  }
  .docs {
    font-family: var(--font-sans);
    margin-left: auto;
  }
  .entry__body {
    border-top: 1px solid var(--color-line);
    margin-top: 0.5rem;
    padding-top: 0.5rem;
  }
  .words {
    display: grid;
    gap: 0.25rem;
    margin: 0.25rem 0;
  }
  .word {
    display: grid;
    grid-template-columns: minmax(3rem, auto) 1.5rem minmax(4rem, 7rem) 1fr;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.15rem 0;
    border-bottom: 1px dashed var(--color-line);
  }
  .word:last-child {
    border-bottom: 0;
  }
  .word__cn {
    font-size: 1.05rem;
    font-weight: 600;
  }
  .word__py {
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .word__kr {
    font-size: 0.95rem;
  }
  .speak {
    font: inherit;
    font-size: 0.8rem;
    line-height: 1;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-muted);
    cursor: pointer;
    flex-shrink: 0;
  }
  .speak:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .speak--on {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .speed {
    margin: 0 0 0.5rem;
  }
  .literal,
  .note,
  .source,
  .example {
    margin: 0.2rem 0 0;
  }
  .example {
    border-left: 2px solid var(--color-line);
    padding-left: 0.6rem;
  }
</style>
