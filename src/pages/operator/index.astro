---
/**
 * /operator — 오퍼레이터 목록.
 *   - 희귀도(★) 섹션. 희귀도·직군은 다중 선택 토글 필터(스크롤 이동 없음), 이름/영문명 검색
 *   - 아바타 썸네일
 * TODO(operator-list): 진영 필터.
 */
import Layout from '../../layouts/Layout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { loadOperators, PROFESSION_LABEL } from '../../lib/data.mjs';

const operators = loadOperators();
const byRarity = new Map<number, typeof operators>();
for (const o of operators) {
  const r = o.rarity ?? 0;
  if (!byRarity.has(r)) byRarity.set(r, []);
  byRarity.get(r)!.push(o);
}
const rarities = [...byRarity.keys()].sort((a, b) => b - a);

const PROFESSIONS = ['PIONEER', 'WARRIOR', 'TANK', 'SNIPER', 'CASTER', 'MEDIC', 'SUPPORT', 'SPECIAL'];
const professionCount = (p: string) => operators.filter((o) => o.profession === p).length;
const stars = (r: number) => (r ? '★'.repeat(r) : '기타');
const op_locale = (o: any) => o.sourceLocale ?? o.locale ?? null;
---

<Layout title="오퍼레이터">
  <div class="container">
    <h1>오퍼레이터</h1>
    <p class="muted small">{operators.length}명. 이름을 누르면 기록 / 대사 / 오퍼레이터 레코드 / 등장 스토리를 볼 수 있습니다.</p>

    <div class="filters">
      <label class="search">
        <span class="shortcuts__label">검색</span>
        <input type="search" id="op-search" placeholder="오퍼레이터 이름 / 영문명" autocomplete="off" />
      </label>

      <div class="shortcuts" role="group" aria-label="희귀도 필터" id="rarity-filter">
        <span class="shortcuts__label">희귀도</span>
        <button type="button" data-all aria-pressed="true">전체</button>
        {rarities.map((r) => (
          <button type="button" data-value={r} aria-pressed="true">{stars(r)} <span class="muted small">{byRarity.get(r)!.length}</span></button>
        ))}
      </div>

      <div class="shortcuts" role="group" aria-label="직군 필터" id="profession-filter">
        <span class="shortcuts__label">직군</span>
        <button type="button" data-all aria-pressed="true">전체</button>
        {PROFESSIONS.map((p) => (
          <button type="button" data-value={p} aria-pressed="true">
            {PROFESSION_LABEL[p]} <span class="muted small">{professionCount(p)}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="muted small" id="op-result"></p>

    {rarities.map((r) => (
      <section id={`r-${r}`} class="rarity" data-rarity={r}>
        <h2>{stars(r)} <span class="muted small count" data-total={byRarity.get(r)!.length}>{byRarity.get(r)!.length}</span></h2>
        <ul class="list-plain grid">
          {byRarity.get(r)!.map((o) => (
            <li data-profession={o.profession} data-name={`${o.name} ${o.appellation}`.toLowerCase()}>
              <a class="card op" href={`/operator/${o.id}`}>
                {o.avatar ? <img class="avatar" src={o.avatar} alt="" loading="lazy" decoding="async" /> : <span class="avatar" />}
                <span class="op__text">
                  <span class="op__name">{o.name} <SourceBadge locale={op_locale(o)} translated={o.translated} /></span>
                  <span class="muted small">
                    {PROFESSION_LABEL[o.profession] ?? o.profession}
                    {o.nationName ? ` · ${o.nationName}` : ''}
                  </span>
                  {o.appearances.length > 0 && <span class="small muted">등장 {o.appearances.length}편</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="muted small empty" hidden>조건에 맞는 오퍼레이터가 없습니다.</p>
      </section>
    ))}
  </div>
</Layout>

<script>
  // 필터: 희귀도·직군은 다중 선택 토글(on/off). "전체" 는 모두 켜기. 검색은 이름/영문명 부분 일치.
  // 상태는 URL 해시(#r=6,5&p=WARRIOR,SNIPER&q=아미야)에 저장해 새로고침/공유 시 복원.
  type Group = { root: HTMLElement; all: HTMLButtonElement; items: HTMLButtonElement[] };
  const group = (id: string): Group => {
    const root = document.getElementById(id)!;
    return {
      root,
      all: root.querySelector<HTMLButtonElement>('[data-all]')!,
      items: Array.from(root.querySelectorAll<HTMLButtonElement>('[data-value]')),
    };
  };
  const rarity = group('rarity-filter');
  const profession = group('profession-filter');
  const search = document.getElementById('op-search') as HTMLInputElement;
  const result = document.getElementById('op-result')!;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.rarity'));
  const cards = Array.from(document.querySelectorAll<HTMLLIElement>('.grid > li'));

  const on = (b: HTMLButtonElement) => b.getAttribute('aria-pressed') === 'true';
  const set = (b: HTMLButtonElement, v: boolean) => b.setAttribute('aria-pressed', String(v));
  const selected = (g: Group) => new Set(g.items.filter(on).map((b) => b.dataset.value!));

  const apply = () => {
    const rs = selected(rarity);
    const ps = selected(profession);
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    for (const sec of sections) {
      const secOn = rs.has(sec.dataset.rarity!);
      let secVisible = 0;
      for (const li of Array.from(sec.querySelectorAll<HTMLLIElement>('.grid > li'))) {
        const show = secOn && ps.has(li.dataset.profession!) && (!q || (li.dataset.name ?? '').includes(q));
        li.hidden = !show;
        if (show) secVisible++;
      }
      sec.hidden = !secOn;
      const count = sec.querySelector<HTMLElement>('.count');
      if (count) count.textContent = String(secVisible);
      const empty = sec.querySelector<HTMLElement>('.empty');
      if (empty) empty.hidden = secVisible > 0;
      visible += secVisible;
    }
    for (const g of [rarity, profession]) set(g.all, g.items.every(on));
    result.textContent = visible === cards.length ? '' : `${visible}명 표시 중`;
    // 해시 갱신 (모두 선택이면 생략)
    const parts: string[] = [];
    if (!rarity.items.every(on)) parts.push(`r=${[...rs].join(',')}`);
    if (!profession.items.every(on)) parts.push(`p=${[...ps].join(',')}`);
    if (q) parts.push(`q=${encodeURIComponent(q)}`);
    history.replaceState(null, '', parts.length ? `#${parts.join('&')}` : location.pathname);
  };

  for (const g of [rarity, profession]) {
    g.all.addEventListener('click', () => {
      // 전체: 모두 켜기. 이미 모두 켜져 있으면 모두 끄기(빠른 단일 선택용)
      const every = g.items.every(on);
      for (const b of g.items) set(b, !every);
      apply();
    });
    for (const b of g.items) {
      b.addEventListener('click', () => {
        set(b, !on(b));
        apply();
      });
    }
  }
  search.addEventListener('input', apply);

  // 해시 복원
  const params = new URLSearchParams(location.hash.slice(1));
  const restore = (g: Group, key: string) => {
    const v = params.get(key);
    if (!v) return;
    const want = new Set(v.split(','));
    for (const b of g.items) set(b, want.has(b.dataset.value!));
  };
  restore(rarity, 'r');
  restore(profession, 'p');
  if (params.get('q')) search.value = params.get('q')!;
  apply();
</script>

<style>
  .filters {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
  }
  .search input {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-fg);
    width: min(100%, 22rem);
  }
  .search input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .rarity h2 {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    padding: 0.4rem 0;
    margin: 1.25rem 0 0.5rem;
    border-bottom: 1px solid var(--color-line);
    z-index: 1;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .op {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.7rem;
    color: inherit;
    height: 100%;
  }
  .op:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .op__text {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    min-width: 0;
  }
  .op__name {
    font-weight: 600;
  }
</style>
