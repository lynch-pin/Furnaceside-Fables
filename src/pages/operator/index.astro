---
/**
 * /operator — 오퍼레이터 목록 (희귀도 내림차순 → 이름순)
 * TODO(operator-list): 직군/진영/희귀도 필터, 검색.
 */
import Layout from '../../layouts/Layout.astro';
import { loadOperators, PROFESSION_LABEL } from '../../lib/data.mjs';

const operators = loadOperators();
const byRarity = new Map<number, typeof operators>();
for (const o of operators) {
  const r = o.rarity ?? 0;
  if (!byRarity.has(r)) byRarity.set(r, []);
  byRarity.get(r)!.push(o);
}
const rarities = [...byRarity.keys()].sort((a, b) => b - a);
---

<Layout title="오퍼레이터">
  <div class="container">
    <h1>오퍼레이터</h1>
    <p class="muted small">{operators.length}명. 이름을 누르면 기록 / 대사 / 오퍼레이터 레코드 / 등장 스토리를 볼 수 있습니다.</p>

    {rarities.map((r) => (
      <section>
        <h2>{r ? `${'★'.repeat(r)}` : '기타'} <span class="muted small">{byRarity.get(r)!.length}</span></h2>
        <ul class="list-plain grid">
          {byRarity.get(r)!.map((o) => (
            <li>
              <a class="card op" href={`/operator/${o.id}`}>
                <span class="op__name">{o.name}</span>
                <span class="muted small">
                  {PROFESSION_LABEL[o.profession] ?? o.profession}
                  {o.nationName ? ` · ${o.nationName}` : ''}
                </span>
                {o.appearances.length > 0 && <span class="small muted">등장 {o.appearances.length}편</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .op {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0.8rem;
    color: inherit;
    height: 100%;
  }
  .op:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .op__name {
    font-weight: 600;
  }
</style>
