---
/**
 * /story — 스토리 목록.
 *   보기 세 가지를 한 화면에서 전환한다. 카드는 한 벌만 그리고 JS 가 보기에 맞춰 다시 묶는다.
 *     - 목록:  종류별 (메인 / 사이드 / 미니 / 오퍼레이터 레코드)
 *     - 팩션:  지역별 (scripts/process-data.mjs 가 본문 언급으로 추정, overrides/regions.json 으로 수정)
 *     - 계열:  인게임 계열별 (RL 방주 / UR 들불 … stage_table.storylines). 메인은 '메인 스토리',
 *             콜라보는 '콜라보', 어디에도 없으면 '기타' 한 덩어리로. (오퍼레이터 레코드 제외)
 *   바로가기 목록도 보기에 따라 바뀐다. 검색은 현재 보기에만 걸린다.
 *
 * JS 가 없으면 종류별 기본 순서로 나열된다.
 */
import Layout from '../../layouts/Layout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { loadStories, KIND_LABEL } from '../../lib/data.mjs';

const { groups, stories, series } = loadStories();
const storyMap = new Map(stories.map((s) => [s.id, s]));

const KIND_ORDER = ['main', 'side', 'mini', 'record', 'other'];
const all = groups
  .filter((g) => g.storyIds.length)
  .sort(
    (a, b) =>
      KIND_ORDER.indexOf(a.kind) - KIND_ORDER.indexOf(b.kind) ||
      (a.kind === 'record' ? a.name.localeCompare(b.name, 'ko') : a.timestamp - b.timestamp),
  );
const events = all.filter((g) => g.kind !== 'record');

// 바로가기: 종류
const kinds = KIND_ORDER.filter((k) => all.some((g) => g.kind === k)).map((k) => ({
  key: k,
  label: KIND_LABEL[k],
  count: all.filter((g) => g.kind === k).length,
}));

// 바로가기: 지역 (이벤트가 많은 지역부터, 미분류는 뒤)
const UNKNOWN_REGION = '미분류';
const regionCount = new Map<string, number>();
for (const g of events) {
  const key = g.regions?.[0]?.name ?? UNKNOWN_REGION;
  regionCount.set(key, (regionCount.get(key) ?? 0) + 1);
}
const regions = [...regionCount.entries()]
  .map(([key, count]) => ({ key, count }))
  .sort((a, b) => (a.key === UNKNOWN_REGION ? 1 : b.key === UNKNOWN_REGION ? -1 : b.count - a.count));

// 바로가기: 인게임 계열 (메인 → 계열 순 → 콜라보 → 기타). 오퍼레이터 레코드는 뺀다.
const COLLAB_SERIES = 'collab';
const OTHER_SERIES = 'other';
const seriesOf = (g: any) => (g.collab ? COLLAB_SERIES : (g.series ?? OTHER_SERIES));
const seriesLabel = new Map<string, string>([
  ['main', '메인 스토리'],
  [COLLAB_SERIES, '콜라보'],
  [OTHER_SERIES, '기타'],
  ...series.filter((s: any) => s.id !== 'main').map((s: any) => [s.id, s.name] as [string, string]),
]);
const seriesCode = new Map<string, string | null>(series.map((s: any) => [s.id, s.code]));
const seriesOrder = [
  'main',
  ...series.filter((s: any) => s.id !== 'main').map((s: any) => s.id),
  COLLAB_SERIES,
  OTHER_SERIES,
].filter((id) => events.some((g: any) => seriesOf(g) === id));
const seriesNav = seriesOrder.map((id) => ({
  key: id,
  code: seriesCode.get(id) ?? null,
  label: seriesLabel.get(id) ?? id,
  count: events.filter((g: any) => seriesOf(g) === id).length,
}));
---

<Layout title="스토리">
  <div class="container">
    <h1>스토리</h1>

    <label class="search">
      <span class="shortcuts__label">검색</span>
      <input type="search" id="story-search" placeholder="이벤트 이름 / 코드" autocomplete="off" />
    </label>

    <div class="shortcuts" role="group" aria-label="보기" id="view-toggle">
      <span class="shortcuts__label">보기</span>
      <button type="button" data-view="kind" aria-pressed="true">목록</button>
      <button type="button" data-view="region" aria-pressed="false">팩션</button>
      <button type="button" data-view="series" aria-pressed="false">계열</button>
    </div>

    <nav class="shortcuts jump jump--kind" aria-label="종류">
      {kinds.map((k) => <a href={`#s-${k.key}`}>{k.label} <span class="muted small">{k.count}</span></a>)}
    </nav>
    <nav class="shortcuts jump jump--region" aria-label="지역" hidden>
      {regions.map((r) => <a href={`#s-${r.key}`}>{r.key} <span class="muted small">{r.count}</span></a>)}
    </nav>
    <nav class="shortcuts jump jump--series" aria-label="계열" hidden>
      {seriesNav.map((s) => (
        <a href={`#s-${s.key}`}>
          {s.code && <span class="code">{s.code}</span>}
          {s.label} <span class="muted small">{s.count}</span>
        </a>
      ))}
    </nav>

    <p class="muted small" id="story-result"></p>

    <div id="story-list" class="groups">
      {all.map((g: any) => (
        <details
          class="card group"
          id={`g-${g.id}`}
          data-id={g.id}
          data-kind={g.kind}
          data-event={g.kind === 'record' ? '0' : '1'}
          data-region={g.regions?.[0]?.name ?? UNKNOWN_REGION}
          data-series={seriesOf(g)}
          data-series-sort={String(g.seriesSort ?? 0)}
          data-name={`${g.name} ${g.code ?? ''}`.toLowerCase()}
        >
          <summary>
            {g.image ? <img class="group__thumb" src={g.image} alt="" loading="lazy" decoding="async" /> : <span class="group__thumb thumb--placeholder" />}
            <span class="group__text">
              <span class="group__name">
                {g.code && <span class="code">{g.code}</span>}
                {g.chapter && <span class="badge">{g.chapter.label}</span>}
                {g.name}
                {g.collab && <span class="badge badge--collab">콜라보 · {g.collab}</span>}
                <SourceBadge locale={g.sourceLocale} translated={g.translated} />
              </span>
              <span class="muted small">
                {[
                  KIND_LABEL[g.kind],
                  g.date ?? null,
                  `${g.storyIds.length}편`,
                  g.kind !== 'record' && g.regions?.length ? g.regions.map((r: any) => r.name).join(', ') : null,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </span>
            </span>
          </summary>
          <ol class="list-plain">
            {g.storyIds.map((id: string) => {
              const st = storyMap.get(id)!;
              return (
                <li class="story-row">
                  {st.available ? (
                    <a href={`/story/${st.id}`}>
                      {st.code && <span class="code">{st.code}</span>} {st.name}
                    </a>
                  ) : (
                    <span class="muted">{st.code && <span class="code">{st.code}</span>} {st.name} (원문 없음)</span>
                  )}
                  {st.avgTag && <span class="muted small"> · {st.avgTag}</span>}
                  {' '}<SourceBadge locale={st.locale} translated={st.translated} />
                </li>
              );
            })}
          </ol>
        </details>
      ))}
    </div>
  </div>
</Layout>

<script>
  // 보기 전환: 카드를 다시 배치하고 구역 제목을 새로 만든다. 상태는 URL 해시(#v=region&q=…).
  const KIND_LABEL: Record<string, string> = {
    main: '메인 스토리',
    side: '사이드 스토리',
    mini: '미니 스토리',
    record: '오퍼레이터 레코드',
    other: '기타',
  };
  const container = document.getElementById('story-list')!;
  const search = document.getElementById('story-search') as HTMLInputElement;
  const result = document.getElementById('story-result')!;
  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
  const jumps = Array.from(document.querySelectorAll<HTMLElement>('.jump'));
  const cards = Array.from(container.querySelectorAll<HTMLElement>('.group'));
  // 서버가 그린 순서(종류 → 시간)를 기억해 두고, 보기마다 이 순서 안에서 다시 묶는다
  const order = new Map(cards.map((c, i) => [c, i]));
  const view = () => viewButtons.find((b) => b.getAttribute('aria-pressed') === 'true')!.dataset.view!;

  // 계열 보기의 구역 제목은 바로가기 칩(코드 + 이름)을 그대로 쓴다
  const seriesChip = new Map<string, { code: string; name: string }>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.jump--series a')) {
    const key = decodeURIComponent(a.getAttribute('href')!.slice(3));
    const clone = a.cloneNode(true) as HTMLElement;
    for (const el of clone.querySelectorAll('.code, .muted')) el.remove();
    seriesChip.set(key, {
      code: (a.querySelector('.code')?.textContent ?? '').trim(),
      name: clone.textContent!.trim(),
    });
  }

  const keyOf = (card: HTMLElement, v: string) =>
    v === 'kind' ? card.dataset.kind! : v === 'region' ? card.dataset.region! : card.dataset.series!;
  const labelOf = (key: string, v: string) => {
    if (v === 'kind') return KIND_LABEL[key] ?? key;
    if (v !== 'series') return key;
    const chip = seriesChip.get(key);
    if (!chip) return key;
    return chip.code ? `<span class="code">${chip.code}</span> ${chip.name}` : chip.name;
  };

  const render = () => {
    const v = view();
    const q = search.value.trim().toLowerCase();
    // 이 보기에 넣을 카드 고르기 (팩션·계열 보기는 이벤트만 — 오퍼레이터 레코드 제외)
    const picked = cards.filter((c) => (v === 'kind' || c.dataset.event === '1') && (!q || (c.dataset.name ?? '').includes(q)));

    const buckets = new Map<string, HTMLElement[]>();
    for (const c of picked) {
      const k = keyOf(c, v);
      if (!buckets.has(k)) buckets.set(k, []);
      buckets.get(k)!.push(c);
    }
    // 구역 순서는 바로가기 목록과 같게 맞춘다
    const navKeys = Array.from(document.querySelectorAll<HTMLAnchorElement>(`.jump--${v} a`)).map((a) =>
      decodeURIComponent(a.getAttribute('href')!.slice(3)),
    );
    const keys = [...buckets.keys()].sort((a, b) => {
      const ia = navKeys.indexOf(a), ib = navKeys.indexOf(b);
      return (ia < 0 ? 1e9 : ia) - (ib < 0 ? 1e9 : ib);
    });

    const frag = document.createDocumentFragment();
    for (const key of keys) {
      const list = buckets.get(key)!.sort((a, b) =>
        v === 'series' && key.startsWith('ssLine_')
          ? Number(a.dataset.seriesSort) - Number(b.dataset.seriesSort)
          : order.get(a)! - order.get(b)!,
      );
      const section = document.createElement('section');
      section.className = 'section';
      section.id = `s-${key}`;
      const h = document.createElement('h2');
      h.innerHTML = `${labelOf(key, v)} <span class="muted small">${list.length}</span>`;
      section.append(h);
      const box = document.createElement('div');
      box.className = 'groups';
      box.append(...list);
      section.append(box);
      frag.append(section);
    }
    container.replaceChildren(frag);

    for (const el of jumps) el.hidden = !el.classList.contains(`jump--${v}`);
    result.textContent = q ? `${picked.length}개` : '';
    const parts: string[] = [];
    if (v !== 'kind') parts.push(`v=${v}`);
    if (q) parts.push(`q=${encodeURIComponent(q)}`);
    history.replaceState(null, '', parts.length ? `#${parts.join('&')}` : location.pathname);
  };

  for (const b of viewButtons) {
    b.addEventListener('click', () => {
      for (const o of viewButtons) o.setAttribute('aria-pressed', String(o === b));
      render();
    });
  }
  search.addEventListener('input', render);

  const params = new URLSearchParams(location.hash.slice(1));
  const wanted = params.get('v');
  if (wanted === 'region' || wanted === 'series') {
    for (const b of viewButtons) b.setAttribute('aria-pressed', String(b.dataset.view === wanted));
  }
  if (params.get('q')) search.value = params.get('q')!;
  render();
  // #g-<이벤트 id> 로 들어온 경우 해당 카드를 펼쳐서 보여 준다
  const target = location.hash.startsWith('#g-') && document.getElementById(location.hash.slice(1));
  if (target instanceof HTMLDetailsElement) {
    target.open = true;
    target.scrollIntoView();
  }
</script>

<style>
  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    margin-bottom: 0.5rem;
  }
  .search input {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-fg);
    width: min(100%, 22rem);
  }
  .search input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .jump {
    max-height: 7.5rem;
    overflow-y: auto;
  }
  .jump--series a {
    font-size: 0.85rem;
  }
  .groups {
    display: grid;
    gap: 0.5rem;
  }
  .group summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    list-style: none;
  }
  .group summary::-webkit-details-marker {
    display: none;
  }
  .group__thumb {
    width: 7rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-line);
    flex-shrink: 0;
  }
  .group__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .group__name {
    font-weight: 600;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.5rem;
  }
  .group ol {
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.5rem;
  }
  .story-row {
    padding: 0.2rem 0;
  }
  .code {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-accent);
  }
</style>
