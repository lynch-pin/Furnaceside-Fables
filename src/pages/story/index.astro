---
/**
 * /story — 스토리 목록 (그룹별)
 * TODO(story-list): 검색 / 종류 필터 (main·side·mini·record) 는 클라이언트 스크립트 없이도
 *   해시 기반 필터나 별도 페이지(/story/main 등)로 확장 가능.
 */
import Layout from '../../layouts/Layout.astro';
import { loadStories, KIND_LABEL } from '../../lib/data.mjs';

const { groups, stories } = loadStories();
const storyMap = new Map(stories.map((s) => [s.id, s]));

const ORDER = ['main', 'side', 'mini', 'record', 'other'];
const sections = ORDER.map((kind) => ({
  kind,
  label: KIND_LABEL[kind],
  groups: groups
    .filter((g) => g.kind === kind && g.storyIds.length)
    .sort((a, b) => (kind === 'record' ? a.name.localeCompare(b.name, 'ko') : a.timestamp - b.timestamp)),
})).filter((s) => s.groups.length);
---

<Layout title="스토리">
  <div class="container">
    <h1>스토리</h1>
    <nav class="kinds" aria-label="종류">
      {sections.map((s) => (
        <a href={`#k-${s.kind}`}>{s.label} <span class="muted small">{s.groups.length}</span></a>
      ))}
    </nav>

    {sections.map((s) => (
      <section id={`k-${s.kind}`}>
        <h2>{s.label}</h2>
        <div class="groups">
          {s.groups.map((g) => (
            <details class="card group" id={g.id}>
              <summary>
                <span class="group__name">
                  {g.chapter && <span class="badge">{g.chapter.label}</span>}
                  {g.name}
                  {g.needsTranslation && <span class="badge badge--fallback">zh_CN</span>}
                </span>
                <span class="muted small">{g.date ?? ''} · {g.storyIds.length}편</span>
              </summary>
              <ol class="list-plain">
                {g.storyIds.map((id) => {
                  const st = storyMap.get(id)!;
                  return (
                    <li class="story-row">
                      {st.available ? (
                        <a href={`/story/${st.id}`}>
                          {st.code && <span class="code">{st.code}</span>} {st.name}
                        </a>
                      ) : (
                        <span class="muted">{st.code && <span class="code">{st.code}</span>} {st.name} (원문 없음)</span>
                      )}
                      {st.avgTag && <span class="muted small"> · {st.avgTag}</span>}
                    </li>
                  );
                })}
              </ol>
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-family: var(--font-sans);
    margin-bottom: 1rem;
  }
  .groups {
    display: grid;
    gap: 0.5rem;
  }
  .group summary {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .group__name {
    font-weight: 600;
  }
  .group ol {
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.5rem;
  }
  .story-row {
    padding: 0.2rem 0;
  }
  .code {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-accent);
    margin-right: 0.25rem;
  }
</style>
