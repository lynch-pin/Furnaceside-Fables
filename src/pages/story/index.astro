---
/**
 * /story — 스토리 목록 (그룹별, 썸네일 포함)
 *   - 이벤트 이름 검색 (클라이언트)
 * TODO(story-list): 스토리 제목까지 검색 확장.
 */
import Layout from '../../layouts/Layout.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { loadStories, KIND_LABEL } from '../../lib/data.mjs';

const { groups, stories } = loadStories();
const storyMap = new Map(stories.map((s) => [s.id, s]));

const ORDER = ['main', 'side', 'mini', 'record', 'other'];
const sections = ORDER.map((kind) => ({
  kind,
  label: KIND_LABEL[kind],
  groups: groups
    .filter((g) => g.kind === kind && g.storyIds.length)
    .sort((a, b) => (kind === 'record' ? a.name.localeCompare(b.name, 'ko') : a.timestamp - b.timestamp)),
})).filter((s) => s.groups.length);
---

<Layout title="스토리">
  <div class="container">
    <h1>스토리</h1>
    <label class="search">
      <span class="shortcuts__label">검색</span>
      <input type="search" id="story-search" placeholder="이벤트 이름" autocomplete="off" />
    </label>
    <nav class="shortcuts" aria-label="종류">
      {sections.map((s) => (
        <a href={`#k-${s.kind}`}>{s.label} <span class="muted small">{s.groups.length}</span></a>
      ))}
    </nav>
    <p class="muted small" id="story-result"></p>

    {sections.map((s) => (
      <section id={`k-${s.kind}`} class="kind">
        <h2>{s.label}</h2>
        <div class="groups">
          {s.groups.map((g) => (
            <details class="card group" id={g.id} data-name={g.name.toLowerCase()}>
              <summary>
                {g.image ? <img class="group__thumb" src={g.image} alt="" loading="lazy" decoding="async" /> : <span class="group__thumb thumb--placeholder" />}
                <span class="group__text">
                  <span class="group__name">
                    {g.chapter && <span class="badge">{g.chapter.label}</span>}
                    {g.name}
                    {g.collab && <span class="badge badge--collab">콜라보 · {g.collab}</span>}
                    <SourceBadge locale={g.sourceLocale} translated={g.translated} />
                  </span>
                  <span class="muted small">{g.date ?? ''} · {g.storyIds.length}편</span>
                </span>
              </summary>
              <ol class="list-plain">
                {g.storyIds.map((id) => {
                  const st = storyMap.get(id)!;
                  return (
                    <li class="story-row">
                      {st.available ? (
                        <a href={`/story/${st.id}`}>
                          {st.code && <span class="code">{st.code}</span>} {st.name}
                        </a>
                      ) : (
                        <span class="muted">{st.code && <span class="code">{st.code}</span>} {st.name} (원문 없음)</span>
                      )}
                      {st.avgTag && <span class="muted small"> · {st.avgTag}</span>}
                      {' '}<SourceBadge locale={st.locale} translated={st.translated} />
                    </li>
                  );
                })}
              </ol>
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>

<script>
  // 이벤트 이름 검색 (부분 일치). 결과가 없는 종류 섹션은 숨긴다. 검색어는 URL 해시(#q=…)에 저장.
  const input = document.getElementById('story-search') as HTMLInputElement;
  const result = document.getElementById('story-result')!;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.kind'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.group'));
  const apply = () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const sec of sections) {
      let n = 0;
      for (const g of Array.from(sec.querySelectorAll<HTMLElement>('.group'))) {
        const show = !q || (g.dataset.name ?? '').includes(q);
        g.hidden = !show;
        if (show) n++;
      }
      sec.hidden = n === 0;
      visible += n;
    }
    result.textContent = q ? `${visible}개 이벤트` : '';
    history.replaceState(null, '', q ? `#q=${encodeURIComponent(q)}` : location.pathname);
  };
  input.addEventListener('input', apply);
  const m = new URLSearchParams(location.hash.slice(1)).get('q');
  if (m) {
    input.value = m;
    apply();
  }
</script>

<style>
  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    margin-bottom: 0.25rem;
  }
  .search input {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-fg);
    width: min(100%, 22rem);
  }
  .search input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .groups {
    display: grid;
    gap: 0.5rem;
  }
  .group summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    list-style: none;
  }
  .group summary::-webkit-details-marker {
    display: none;
  }
  .group__thumb {
    width: 7rem;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 4px;
    background: var(--color-line);
    flex-shrink: 0;
  }
  .group__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .group__name {
    font-weight: 600;
  }
  .group ol {
    margin-top: 0.75rem;
    border-top: 1px solid var(--color-line);
    padding-top: 0.5rem;
  }
  .story-row {
    padding: 0.2rem 0;
  }
  .code {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-accent);
    margin-right: 0.25rem;
  }
</style>
