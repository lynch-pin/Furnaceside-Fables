---
/**
 * /story/[id] — 개별 스토리 리더.
 * 빌드 시 gamedata/ 의 스크립트 원문을 ko_KR → zh_CN 순으로 읽어 파싱한다.
 */
import Layout from '../../layouts/Layout.astro';
import StoryReader from '../../components/StoryReader.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { loadStories, loadOperators, KIND_LABEL } from '../../lib/data.mjs';
import { readStoryText, applyStoryTranslation } from '../../lib/i18n.mjs';
import { parseStory } from '../../lib/story-parser.mjs';

export async function getStaticPaths() {
  const { stories } = loadStories();
  return stories.filter((s) => s.available).map((s) => ({ params: { id: s.id }, props: { story: s } }));
}

const { story } = Astro.props;
const { groups, stories } = loadStories();
const group = groups.find((g) => g.id === story.groupId)!;
const operators = loadOperators();
const opName = new Map(operators.map((o) => [o.id, o.name]));
const nameToId = new Map(operators.map((o) => [o.name, o.id]));

const raw = readStoryText(story.txt);
let lines = raw ? parseStory(raw.text) : [];
let translated = false;
if (raw?.needsTranslation) {
  // CN 원문: translations/zh_CN/stories/<id>.json 캐시가 있으면 적용 (scripts/translate.mjs 로 생성)
  ({ lines, translated } = applyStoryTranslation(story.id, lines, raw.locale));
}

// 같은 그룹 내 이전/다음 스토리
const siblings = group.storyIds.filter((id) => stories.find((s) => s.id === id)?.available);
const idx = siblings.indexOf(story.id);
const prev = idx > 0 ? stories.find((s) => s.id === siblings[idx - 1]) : null;
const next = idx < siblings.length - 1 ? stories.find((s) => s.id === siblings[idx + 1]) : null;

const title = [story.code, story.name].filter(Boolean).join(' ');
---

<Layout title={title} description={story.summary ?? undefined}>
  <article class="container container--narrow">
    <header class="story-head">
      <p class="crumbs small muted">
        <a href="/story">스토리</a> › <a href={`/story#${group.id}`}>{group.name}</a>
        {group.chapter && <span> · {group.chapter.label}</span>}
      </p>
      <h1>
        {story.code && <span class="code">{story.code}</span>}
        {story.name}
      </h1>
      <p class="meta small muted">
        <span class="badge">{KIND_LABEL[story.kind]}</span>
        {story.avgTag && <span>{story.avgTag}</span>}
        {story.date && <span>{story.date}</span>}
        <SourceBadge locale={raw?.locale} translated={translated} />
      </p>
      {story.image && <img class="thumb story-thumb" src={story.image} alt="" loading="eager" decoding="async" />}
      {story.summary && <p class="summary">{story.summary}</p>}

      {story.characters.length > 0 && (
        <p class="cast small">
          <span class="muted">등장 오퍼레이터: </span>
          {story.characters.map((c: any, i: number) => (
            <>
              {i > 0 && ', '}
              <a href={`/operator/${c.id}`} title={c.lines ? `${c.lines}줄` : '등장'}>{opName.get(c.id) ?? c.id}</a>
            </>
          ))}
        </p>
      )}
    </header>

    <StoryReader lines={lines} nameToId={nameToId} />

    <nav class="pager" aria-label="이전/다음 스토리">
      {prev ? <a href={`/story/${prev.id}`}>← {prev.code ? `${prev.code} ` : ''}{prev.name}</a> : <span />}
      {next ? <a href={`/story/${next.id}`}>{next.code ? `${next.code} ` : ''}{next.name} →</a> : <span />}
    </nav>
  </article>
</Layout>

<style>
  .story-head {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }
  .story-head h1 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.6rem;
  }
  .code {
    font-family: var(--font-sans);
    font-size: 0.7em;
    color: var(--color-accent);
    margin-right: 0.4rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
  }
  .summary {
    white-space: pre-line;
  }
  .story-thumb {
    margin: 1rem 0;
    max-height: 18rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
</style>
