{
  "name": "furnaceside-fables",
  "version": "0.1.0",
  "description": "아크나이츠 스토리 / 연표 / 오퍼레이터 아카이브 (비상업적 팬 사이트)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "bash scripts/sync-data.sh",
    "process": "node scripts/process-data.mjs && npm run glossary && npm run catalog",
    "prepare": "npm run sync && npm run process",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs",
    "translate": "node scripts/translate.mjs",
    "glossary": "node --max-old-space-size=3500 scripts/build-glossary.mjs",
    "catalog": "node scripts/build-asset-catalog.mjs",
    "image": "node scripts/fetch-image.mjs"
  },
  "dependencies": {
    "astro": "^7.3.3"
  }
}
